      inset: 0;
      background: rgba(0, 0, 0, 0.7);
    }

    .lab-modal-container {
      position: relative;
      width: 90%;
      max-width: 800px;
      max-height: 90vh;
      background: #ffffff;
      border-radius: 8px;
      padding: 24px;
      z-index: 2;
      overflow-y: auto;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    .modal-close {
      position: absolute;
      top: 15px;
      right: 15px;
      background: #f0f0f0;
      border: none;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      cursor: pointer;
      font-weight: bold;
