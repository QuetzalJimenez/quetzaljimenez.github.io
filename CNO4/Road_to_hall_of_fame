    }

    .lab-content {
      display: flex;
      gap: 20px;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .lab-thumb {
      width: 220px;
      height: 130px;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid #eee;
      background: #f8f8f8;
