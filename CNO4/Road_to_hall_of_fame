    /* Dropdown Navegación */
    .nav-dropdown {
      position: relative;
      display: inline-block;
    }

    .dropdown-toggle {
      background: transparent;
      border: 1px solid #444;
      padding: 0.25rem 0.5rem;
      cursor: pointer;
      border-radius: 4px;
      color: #fff;
      font-size: 0.9rem;
    }

    .dropdown-toggle:hover {
      background: #222;
    }

    .dropdown-menu {
      position: absolute;
      left: 0;
      top: calc(100% + 6px);
      list-style: none;
      margin: 0;
      padding: 0.25rem 0;
      background: #fff;
      border: 1px solid #ddd;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      min-width: 160px;
      z-index: 20;
      border-radius: 4px;
    }

    .dropdown-menu[hidden] {
      display: none;
    }

    .dropdown-menu li a {
      display: block;
      padding: 0.4rem 0.8rem;
      color: #222;
      text-decoration: none;
    }

    .dropdown-menu li a:hover {
      background: #f2f6ff;
      color: #0b3d91;
    }

    /* Botón Descarga PDF (Estilo Base) */
