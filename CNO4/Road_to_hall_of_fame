      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    .pdf-button:focus {
      outline: 3px solid #888;
      outline-offset: 3px;
    }

    /* ==========================================================================
       2. ESTILOS ESPECÍFICOS PARA ROAD TO HALL OF FAME (ACTIVIDAD 06)
       ========================================================================== */
    .hero-hall {
      background: #fafafa;
      border-bottom: 1px solid #eee;
      padding: 40px 20px;
