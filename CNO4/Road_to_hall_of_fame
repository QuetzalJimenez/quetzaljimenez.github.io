      border-radius: 4px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .btn-evidence:hover {
      background: #121212;
      color: #fff;
      border-color: #121212;
    }

    /* ==========================================================================
